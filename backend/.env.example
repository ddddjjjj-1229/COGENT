# Copy this file to backend/.env and fill in the API key for the model
# provider you want to use. You do not need to fill every key.

# ---------------------------------------------------------------------------
# LLM providers
# ---------------------------------------------------------------------------

# DeepSeek models, e.g. deepseek-chat or deepseek-v4-flash.
DEEPSEEK_API_KEY=

# Qwen models through Alibaba Cloud DashScope.
# Fill either DASHSCOPE_API_KEY or QWEN_API_KEY. DASHSCOPE_API_KEY is preferred.
DASHSCOPE_API_KEY=
QWEN_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional: other OpenAI-compatible or third-party providers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TOGETHER_API_KEY=

# Optional: local Ollama server.
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Search providers used by retrieval/RAG tools
# ---------------------------------------------------------------------------

# Optional: fill one search provider key if internet search is enabled.
SERPER_API_KEY=
BING_SUBSCRIPTION_KEY=
BING_SEARCH_URL=
BRAVE_API_KEY=
